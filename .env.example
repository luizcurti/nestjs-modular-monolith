DATABASE_DATASOURCE=typeorm

REDIS_HOST=0.0.0.0
REDIS_PORT=6379

TYPEORM_TYPE=postgres
TYPEORM_HOST=0.0.0.0
TYPEORM_PORT=5432
TYPEORM_USERNAME=qso_user
TYPEORM_PASSWORD=qso_password
TYPEORM_DATABASE=qso_example
MONGODB_URL=mongodb://127.0.0.1:27017/users_management

# Optional, for managed services (see docs/deployment.md): an AUTH token
# requires TLS on ElastiCache; RDS requires TLS by default.
# REDIS_PASSWORD=
# REDIS_TLS=true
# TYPEORM_SSL=true
